+#pragma mark - Keyboard refresh
+
+// An invisible field to hold first responder for a moment (see updateProps), with the focused field's keyboard
+// settings so the keyboard has nothing to change for it. Not hidden: a hidden field can't become first responder.
+- (UITextField *)_keyboardStandIn
+{
+  UITextField *standIn = [[UITextField alloc] initWithFrame:CGRectZero];
+  standIn.alpha = 0;
+  standIn.keyboardType = _backedTextInputView.keyboardType;
+  standIn.keyboardAppearance = _backedTextInputView.keyboardAppearance;
+  standIn.returnKeyType = _backedTextInputView.returnKeyType;
+  standIn.autocapitalizationType = _backedTextInputView.autocapitalizationType;
+  standIn.autocorrectionType = _backedTextInputView.autocorrectionType;
+  standIn.spellCheckingType = _backedTextInputView.spellCheckingType;
+  [self addSubview:standIn];
+  return standIn;
+}
