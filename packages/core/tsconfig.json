{
  "compilerOptions": {
    "target": "ES2022",
    // no DOM: the apps run this on the web and in React Native, so it can only
    // use the language itself. Code that needs a browser API stays in web
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": []
  },
  "include": ["src"]
}
